{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinchy",
  "version": "0.1.0",
  "identifier": "com.chanyounghur.pastel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pinchy",
        "width": 1200,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Pinchy 설정",
        "url": "settings.html",
        "width": 400,
        "height": 300,
        "visible": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**",
          "$APPDATA/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
