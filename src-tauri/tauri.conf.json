{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinchy",
  "version": "0.3.5",
  "identifier": "com.chanyounghur.pastel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pinchy",
        "width": 1200,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Pinchy 설정",
        "url": "settings.html",
        "width": 400,
        "height": 580,
        "visible": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**",
          "$APPDATA/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzM0MzNkZGRTIyQ0JGNDEKUldSQnZ5emkvelk4NDgzYm15clhHTkF4VmlpQzl0ZnNnZjZsemhseHp3bmJGb0p0QjZHNzM4RysK",
      "endpoints": [
        "https://github.com/chanyounghur/Pinchy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
