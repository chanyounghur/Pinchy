{
  "expo": {
    "name": "Pinchy",
    "slug": "pinchy",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pinchy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.chanyounghur.pinchy",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chanyounghur.pinchy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFAF3"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "데스크톱 Pinchy의 QR을 찍어 연결할 때만 카메라를 써요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앨범에서 고른 사진을 히스토리에 올릴 때만 사진을 써요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "앨범에서 고른 사진을 히스토리에 올릴 때만 사진을 써요.",
          "savePhotosPermission": "히스토리의 사진을 앨범에 저장할 때만 써요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FCFAF3",
          "dark": {
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "*/*"
          ]
        }
      ]
    ],
    "runtimeVersion": "3",
    "updates": {
      "url": "https://pinchy.invalid/updates/manifest",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "disableAntiBrickingMeasures": true
    }
  }
}
